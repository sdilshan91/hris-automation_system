<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HRM.Api</RootNamespace>
    <UserSecretsId>817c7ff7-edc1-43aa-a003-103d78d70949</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
    <PackageReference Include="Hangfire.Core" Version="1.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.*" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.*" />
    <PackageReference Include="MediatR" Version="12.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.*" />
    <!-- US-NTF-001: SignalR Redis backplane for multi-instance scale-out (FR-10). OPTIONAL at runtime —
         only used when a Redis connection string is configured; otherwise the default in-memory backplane
         is used so the app starts and tests pass without Redis. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.*" />
    <!-- US-PLT-006: error tracking via self-hosted GlitchTip (Sentry-API-compatible). GlitchTip speaks the
         Sentry protocol, so we use the mature Sentry .NET SDK. 6.7.0 is on the 6.6.0+ line that explicitly
         adds .NET 10 support (verified 2026-07-24). SAFE-BY-DEFAULT: the SDK is only wired when GlitchTip:Dsn
         is non-blank (blank is the shipped default), so with no DSN there is no init and no network activity.
         Sentry.AspNetCore = ASP.NET Core integration (UseSentry + BeforeSend scrub); Sentry.Serilog = the
         Serilog Error-level sink, added ALONGSIDE the existing console+file sinks (additive, AC-4). -->
    <PackageReference Include="Sentry.AspNetCore" Version="6.7.0" />
    <PackageReference Include="Sentry.Serilog" Version="6.7.0" />
  </ItemGroup>

  <!-- P3 observability (docs/Architecture/observability-otel-grafana-plan.md). OpenTelemetry traces + metrics.
       Exporter is ENDPOINT-GATED (see Observability/ObservabilityExtensions.cs): OTLP when an endpoint
       is configured, else Console-only, so the app runs with no collector. DB spans come from Npgsql's
       STABLE built-in ActivitySource via AddSource("Npgsql") (no extra package — Npgsql core already
       ships it); OpenTelemetry.Instrumentation.EntityFrameworkCore is still pre-release. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.16.0" />
    <!-- Redis command-spans (plan §5): instruments the SHARED IConnectionMultiplexer used by IDistributedCache +
         the SignalR backplane (registered in Program.cs, resolved from DI by AddRedisInstrumentation). Only the
         1.x-beta line ships for this instrumentation; pinned to 1.16.0-beta.1 to match the OTel 1.16.0 core above.
         The EF second-level cache uses its OWN provider-internal multiplexer and is NOT covered (see ISSUE-274). -->
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.16.0-beta.1" />
  </ItemGroup>

  <!-- P3 infra health probes (/health/live, /health/ready). Postgres readiness via AspNetCore.HealthChecks.Npgsql;
       Redis readiness (AspNetCore.HealthChecks.Redis) is registered only when a Redis connection string is set. -->
  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Npgsql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRM.Application\HRM.Application.csproj" />
    <ProjectReference Include="..\HRM.Infrastructure\HRM.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Expose internals to the test project so job-level helpers (e.g. LeaveReportExportJob.DispatchReportReadyAsync,
       US-NTF-006 Phase 8) can be unit-tested directly without going public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HRM.Tests" />
  </ItemGroup>

</Project>
