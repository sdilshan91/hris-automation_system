{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hris_dev_db;Username=developer;Password=",
    "PrivilegedConnection": "",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=1000"
  },
  "Rls": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "hrm-api",
    "Audience": "hrm-client",
    "PrivateKey": ""
  },
  "Authentication": {
    "Entra": {
      "_comment": "CR-AUTH-001 Enterprise SSO (Microsoft Entra/O365). Enabled=false OR blank ClientId/ClientSecret/RedirectUri → SSO is OFF (login button reports 'not configured'). Put ClientSecret in user-secrets, NOT here: dotnet user-secrets set \"Authentication:Entra:ClientSecret\" \"<secret>\". TenantAllowList (the US-AUTH-013 isolation guard) is dev-only config and lives in appsettings.Development.json.",
      "Enabled": true,
      "Instance": "https://login.microsoftonline.com/",
      "Authority": "https://login.microsoftonline.com/organizations/v2.0",
      "ClientId": "79d5dfe7-e5c6-4b2f-a72d-f553c41e25e2",
      "ClientSecret": "",
      "CallbackPath": "/api/v1/auth/sso/callback",
      "RedirectUri": "",
      "Scopes": "openid profile email"
    }
  },
  "Platform": {
    "BaseDomain": "yourhrm.com",
    "TenantCacheTtlMinutes": 5,
    "ReservedSubdomains": [
      "www", "api", "admin", "app", "mail", "status", "docs",
      "help", "support", "static", "cdn", "dev", "stage", "prod", "test", "qa"
    ]
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/hrm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
