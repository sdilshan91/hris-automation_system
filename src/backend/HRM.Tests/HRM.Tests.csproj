<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>HRM.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="NSubstitute" Version="5.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRM.Api\HRM.Api.csproj" />
    <ProjectReference Include="..\HRM.Domain\HRM.Domain.csproj" />
    <ProjectReference Include="..\HRM.Application\HRM.Application.csproj" />
    <ProjectReference Include="..\HRM.Infrastructure\HRM.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ISSUE-275: ~45 integration classes each spin up their own postgres:17 Testcontainer and run the full
         migration chain in IAsyncLifetime. At xUnit's default parallelism (= CPU cores) too many migrate at once and
         the host saturates → intermittent Npgsql "Timeout during reading attempt" during MigrateAsync. xunit.runner.json
         caps maxParallelThreads to bound the concurrent-container count (the runner reads it from the output dir).

         2026-08-07: the cap was 4, which held on an 8-core dev box but NOT on the 2-core CI runner. Once ci-gate
         actually started firing (the trigger had pointed at a stale branch, so it had not run on a merged PR since
         2026-07-01) every run failed the same way: the shared HttpApi factory's host dies mid-run and all 26 classes
         in that collection report "The server has not been started" — 58 failures, 11-17 minutes in. The two
         WebApplicationFactory harnesses added in #476 each carry their own container too, which pushed it over.
         Lowered to 2. Same failure class ISSUE-275 identified; the cap was simply tuned for the wrong machine. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
