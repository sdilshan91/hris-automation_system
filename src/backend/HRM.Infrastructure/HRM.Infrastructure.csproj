<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HRM.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HRM.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.*" />
    <!-- CR-AUTH-001 Increment 2: Microsoft Entra OIDC SSO. Provides ConfigurationManager +
         OpenIdConnectConfiguration for discovery-document / JWKS retrieval used to validate the
         id_token signature & issuer. JwtBearer (above) already pulls Microsoft.IdentityModel.* 8.x
         transitively; this aligns to that line. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <PackageReference Include="Hangfire.Core" Version="1.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.*" />
    <!-- Pin Newtonsoft.Json to a patched version: Hangfire.PostgreSql pulls a vulnerable 11.0.1
         transitively (NU1903 / GHSA-5crp-9r3c-p9vr). A direct reference overrides the transitive. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageReference Include="Otp.NET" Version="1.*" />
    <PackageReference Include="QRCoder" Version="1.*" />
    <PackageReference Include="ClosedXML" Version="0.*" />
    <PackageReference Include="CsvHelper" Version="33.*" />
    <!-- US-ATT-007 FR-6/AC-4: PDF export of the monthly attendance summary. QuestPDF Community license
         (free for our use). LeaveReports (US-LV-012) only did CSV/XLSX, so this is a NEW dependency. -->
    <PackageReference Include="QuestPDF" Version="2024.*" />
    <!-- US-REC-001 NFR-4: HTML sanitization of rich-text vacancy description/qualifications to prevent
         XSS (OWASP). HtmlSanitizer (Ganss.Xss) is a vetted allow-list sanitizer; a hand-rolled regex
         stripper would be unsafe. NEW dependency for the Recruitment module. -->
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <!-- US-CHR-001 AC-4 / US-CHR-008 FR-5 (privacy): strip EXIF/IPTC/XMP metadata (GPS, camera PII)
         from uploaded raster images before storage. SixLabors.ImageSharp is the standard .NET imaging
         library; a hand-rolled JPEG APP1-segment stripper would be fragile and unsafe. NEW dependency
         for the Core HR photo/document upload paths.
         LICENSE NOTE: pinned to the 2.1.x line, which is Apache-2.0 (permissive, no key). ImageSharp
         v3+ moved to the source-available "Six Labors Split License" and v4 ENFORCES a build-time paid
         license key — do not upgrade past 2.1.x without a licensing decision. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- US-LV-007 FR-5: static holiday seeding templates (embedded, not a third-party API). -->
    <EmbeddedResource Include="Services\HolidayTemplates\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRM.Application\HRM.Application.csproj" />
  </ItemGroup>

</Project>
