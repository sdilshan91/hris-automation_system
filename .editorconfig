; EditorConfig — the ruleset `dotnet format` reads. Before this file existed, `dotnet format`
; ran on implicit defaults, so "formatted" meant whatever the last editor happened to do.
;
; Deliberately FORMATTING-ONLY. Analyzer/code-style diagnostics are left at their default
; severity: raising them here would flood the build with new warnings across ~1,200 existing
; source files in the same change that introduces the file, and a gate nobody can pass is a
; gate that gets switched off. Tighten incrementally, with the diff to back it up.
root = true

; NOTE — `end_of_line` is deliberately NOT declared. The working tree currently holds MIXED
; line endings (a 600-file backend sample: 457 CRLF / 144 LF; frontend .ts: 285 CRLF / 115 LF),
; because core.autocrlf=input normalizes on commit but never on checkout, and .gitattributes
; pins only `*.sh` (added for ISSUE-323, where a CRLF checkout silently broke the aborted-run
; guard in scripts/run-backend-tests.sh). Asserting `end_of_line = lf` here would make
; `dotnet format` rewrite ~70% of every file in the repo in one diff. Normalizing the tree is
; the right fix, but it is a deliberate, standalone change — see docs/QA/TEST-FINDINGS.md.

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

# --- C# formatting (matches the existing Clean Architecture / CQRS source) ---
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true

csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

# `using` directives: System first, then the rest, alphabetically.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# EF Core scaffolds migrations as UTF-8 **with BOM** — all 290 files under Migrations/ carry
# one, while all 2,378 hand-written .cs files do not. Declaring the BOM here matches what
# `dotnet ef migrations add` actually emits; without it every newly generated migration would
# report a CHARSET violation and `dotnet format` would rewrite tool-generated output, which
# this repo's "never hand-write migrations" rule exists to prevent.
[src/backend/**/Persistence/Migrations/*.cs]
charset = utf-8-bom

[*.{csproj,props,targets,config,nuspec}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

# Generated code is not source. `contracts/openapi/hrm-v1.json` is emitted by
# scripts/gen-openapi.sh and `api-types.ts` by `npm run api:types` — both are compared
# byte-for-byte by their CI gates, so reformatting them would break the contract check.
[contracts/openapi/**]
insert_final_newline = false
trim_trailing_whitespace = false

[src/frontend/src/app/core/api/generated/**]
insert_final_newline = false
trim_trailing_whitespace = false

[*.{ts,js,html,scss,css}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown — stripping them changes rendering.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
