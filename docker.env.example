# Template for the docker compose env file. Copy to `docker.env` (gitignored) and edit:
#   cp docker.env.example docker.env
# Both Postgres and the backend read this file (see `env_file:` in docker-compose.yml).

# --- Postgres container ---
POSTGRES_USER=developer
POSTGRES_PASSWORD=change-me-in-docker-env
POSTGRES_DB=hris_dev_db

# --- Backend (.NET reads config from env; "__" = nested key) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
# Keep Username/Password below in sync with POSTGRES_* above.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=hris_dev_db;Username=developer;Password=change-me-in-docker-env
ConnectionStrings__Redis=redis:6379,abortConnect=false,connectTimeout=2000

# Optional: paste an RSA private key (PEM) so issued JWTs survive backend restarts.
# Leave blank to auto-generate a key on each startup (existing tokens stop working after a restart).
Jwt__PrivateKey=

# --- Upload malware scanning (ISSUE-101) ---
# BLANK (the default) => the app uses the AllowWithLog stub (no scanning) — correct for local/dev.
# To enable fail-closed ClamAV scanning: bring up the clamd container with `docker compose --profile scanning up`
# and set the host below to the service name. Fail-closed = a down/unreachable daemon REJECTS uploads (400).
# See src/backend/HRM.Infrastructure/Services/VIRUS-SCANNING.md.
VirusScanning__ClamAv__Host=
# VirusScanning__ClamAv__Host=clamav   # <- uncomment in staging/prod (with --profile scanning)
