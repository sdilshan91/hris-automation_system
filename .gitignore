*.suo

# Playwright MCP (browser debugging artifacts: traces, screenshots, sessions)
.playwright-artifacts/

# Per-agent working memory. TRACKED as of 2026-08-22 — it used to be ignored, and that put 107 of
# the project's 141 accumulated agent notes (76%) on a single NTFS drive: never reviewed, never
# shared, gone with the machine. `frontend-dev` alone had 41. Meanwhile docs/vault/ — the store that
# DOES travel — fell from 70 commits in June to 5 in August. The ignore rule was quietly deciding
# where knowledge went. Secret-scanned before tracking (no credentials found); secret-guard exempts
# ignored files, so nothing had ever checked these.
# Only the volatile bits stay ignored:
.claude/agent-memory/**/*.tmp
.claude/agent-memory/**/.cache/

# test result artifacts
TestResults/
*.trx

# Serilog rolling log files
Logs/
log-*.txt

# Test run artifacts
test-results/
playwright-report/
.playwright-artifacts/

# /freeze guard state (per-session, never committed)
.claude/hooks/.freeze-dir
.claude/hooks/vault-compliance.log

# Local backup archive (not source)
.claude.zip

# Backend runtime artifacts (tenant uploads, local agent memory)
src/backend/HRM.Api/uploads/
src/backend/HRM.Api/.claude/

# Local TLS dev proxy — private keys + downloaded nginx binary (never commit)
local-dev/certs/
local-dev/nginx/
local-dev/nginx.zip

# GlitchTip local secrets
ops/glitchtip/.env

# Platform DB backups (ISSUE-330) — never commit dumps
ops/backup/dumps/
ops/backup/*.log

# Obsidian: share the vault config, never the per-machine window layout (it churns every session)
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache
