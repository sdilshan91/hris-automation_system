.codex/settings.local.json
.codex/tmp/
.codex/runs/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Node (frontend)
node_modules/
dist/
.angular/

# .NET (backend)
bin/
obj/
*.user
*.suo

# Playwright MCP (browser debugging artifacts: traces, screenshots, sessions)
.playwright-artifacts/

# Private per-agent working memory (auto-loaded locally; not shared config — excluded from agnix lint)
.claude/agent-memory/

# test result artifacts
TestResults/
*.trx

# Serilog rolling log files
Logs/
log-*.txt

# Test run artifacts
test-results/
playwright-report/
.playwright-artifacts/

# /freeze guard state (per-session, never committed)
.claude/hooks/.freeze-dir

# Local backup archive (not source)
.claude.zip

# Backend runtime artifacts (tenant uploads, local agent memory)
src/backend/HRM.Api/uploads/
src/backend/HRM.Api/.claude/

# Local TLS dev proxy — private keys + downloaded nginx binary (never commit)
local-dev/certs/
local-dev/nginx/
local-dev/nginx.zip

# GlitchTip local secrets
ops/glitchtip/.env

# Platform DB backups (ISSUE-330) — never commit dumps
ops/backup/dumps/
ops/backup/*.log
