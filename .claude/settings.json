{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "Edit(*)",
      "Write(*)",
      "Bash(*)",
      "Bash(cd *)",
      "Bash(curl *)",
      "Bash(psql *)",
      "Bash(export *)",
      "Bash(PSQL=*)",
      "PowerShell(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__chrome-devtools__*"
    ],
    "deny": [],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(firebase *)",
      "Bash(gcloud *)",
      "Bash(wget *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Stop-Process *)"
    ],
    "additionalDirectories": [
      "C:\\HRIS\\.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/secret-guard.py\"", "timeout": 5 },
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/test-integrity-guard.py\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-user-story-commit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-dev-commit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/scripts/hooks.py", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/scripts/hooks.py", "timeout": 5 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/scripts/hooks.py", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/scripts/hooks.py", "timeout": 5 }
        ]
      }
    ]
  },
  "skillOverrides": {
    "akka-aspire-configuration": "off",
    "akka-best-practices": "off",
    "akka-hosting-actor-patterns": "off",
    "akka-management": "off",
    "akka-testing-patterns": "off",
    "aspire-configuration": "off",
    "aspire-integration-testing": "off",
    "aspire-mailpit-integration": "off",
    "aspire-service-defaults": "off",
    "playwright-blazor": "off",
    "playwright-ci-caching": "off",
    "mjml-email-templates": "off",
    "verify-email-snapshots": "off",
    "r3-reactive-extensions": "off",
    "ilspy-decompile": "off",
    "dotnet-devcert-trust": "off",
    "local-tools": "off",
    "marketplace-publishing": "off",
    "skills-index-snippets": "off",
    "slopwatch": "off"
  }
}
